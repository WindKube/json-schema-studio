{
  "name": "json-schema-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p worker && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "migrate": "wrangler d1 migrations apply DB --local",
    "deploy": "pnpm build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@tanstack/react-query": "^5.105.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "fast-json-patch": "^3.1.1",
    "hono": "^4.13.14",
    "idb-keyval": "^6.3.0",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
